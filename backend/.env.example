MONGO_URI=
PORT=
ENCRYPTION_KEY =
JWT_SECRET=
NODE_ENV="development"

#cronjob EMAIL
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=

EMAIL_SERVICE="Outlook365"

#frontend
BASE_URL=

# Chat internal. Endpoint harus OpenAI-compatible: POST /chat/completions.
# Ganti base URL dan nama model saat pindah provider, misalnya DashScope.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v3.2
LLM_FALLBACK_MODEL=qwen/qwen3-32b

# Level Hemat dan Kuat. Kosongkan base URL/key untuk memakai LLM_BASE_URL dan LLM_API_KEY.
# Dropdown IT: Hemat, Pas, Kuat. Bisa diganti di tengah percakapan.
LLM_HEMAT_MODEL=qwen/qwen3-32b
LLM_PRECISE_BASE_URL=
LLM_PRECISE_API_KEY=
LLM_PRECISE_MODEL=openai/gpt-4.1-mini
LLM_PRECISE_FALLBACK_MODEL=
CHAT_TOKEN_TTL_SECONDS=900

# RAG. Kosong = pakai LLM_BASE_URL dan LLM_API_KEY. Index: npm run rag:index
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=hub_knowledge
