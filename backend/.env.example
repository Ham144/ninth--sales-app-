MONGO_URI=
PORT=
ENCRYPTION_KEY =
JWT_SECRET=
NODE_ENV="development"

#cronjob EMAIL
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=

EMAIL_SERVICE="Outlook365"

#frontend
BASE_URL=

# Chat internal. Endpoint harus OpenAI-compatible: POST /chat/completions.
# Ganti base URL dan nama model saat pindah provider, misalnya DashScope.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODEL=

# Mode Teliti, opsional. Kosongkan base URL/key untuk memakai LLM_BASE_URL dan LLM_API_KEY.
# Dropdown chat hanya menampilkan Cepat/Teliti, bukan nama model.
LLM_PRECISE_BASE_URL=
LLM_PRECISE_API_KEY=
LLM_PRECISE_MODEL=
LLM_PRECISE_FALLBACK_MODEL=
CHAT_TOKEN_TTL_SECONDS=900
